{
    "user": "realStandal",
    "repo": "SA-MP-MySQL",
    "resources": [
        {
            "name": "^mysql-(.*).tar.gz$",
            "platform": "linux",
            "archive": true,
            "includes": ["mysql-(.*)/pawno/include"],
            "plugins": [
                "mysql-(.*)/plugins/mysql.so",
                "mysql-(.*)/plugins/mysql_static.so"
            ]
        },
        {
            "name": "^mysql-(.*)-win32.zip$",
            "platform": "windows",
            "archive": true,
            "includes": ["mysql-(.*)-win32\\/pawno\\/include"],
            "plugins": ["mysql-(.*)-win32\\/plugins\\/mysql.dll"],
            "files": {
                "mysql-(.*)-win32\\/libmariadb.dll": "libmariadb.dll"
            }
        }
    ],
    "runtime": {
        "plugins": ["realStandal/SA-MP-MySQL"]
    },
    "contributors": [
        "AndreT",
        "DamianC",
        "IstuntmanI",
        "JernejL",
        "Konstantinos",
        "krisk",
        "kurta999",
        "Kye",
        "maddinat0r",
        "Mow",
        "nemesis",
        "Sergei",
        "xxmitsu"
    ]
}
