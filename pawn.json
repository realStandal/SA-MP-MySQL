{
    "user": "realStandal",
    "repo": "SA-MP-MySQL",
    "resources": [
        {
            "name": "^mysql-(.*)\\.tar\\.gz$",
            "platform": "linux",
            "archive": true,
            "includes": ["pawno/include"],
            "plugins": [
                "plugins/mysql.so",
                "plugins/mysql_static.so"
            ]
        },
        {
            "name": "^mysql-(.*)-win32\\.zip$",
            "platform": "windows",
            "archive": true,
            "includes": ["pawno/include"],
            "plugins": ["plugins/mysql.dll"],
            "files": {
                "libmariadb.dll": "libmariadb.dll"
            }
        }
    ],
    "runtime": {
        "plugins": ["realStandal/SA-MP-MySQL"]
    },
    "contributors": [
        "AndreT",
